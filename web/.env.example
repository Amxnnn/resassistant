# Copy to web/.env.local and fill in. Never commit real env files.

# Shared secret the agent sends as x-agent-key. Must match AGENT_API_KEY in agent/.env
AGENT_API_KEY=

# Supabase (project settings → API / database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# LiveKit (token route for browser test calls)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
