  "info_entries": [
    {
      "topic": "hours",
      "language": "en",
      "answer": "Open Tuesday to Sunday, 12 to 3 PM for lunch and 6 to 11 PM for dinner. We are closed on Mondays."
    },
    {
      "topic": "hours",
      "language": "hi",
      "answer": "हम मंगलवार से रविवार दोपहर 12 से 3 बजे और शाम 6 से 11 बजे तक खुले हैं। सोमवार को बंद रहते हैं।"
    },
    {
      "topic": "location",
      "language": "en",
      "answer": "12 Residency Road, right near the Brigade Road junction in central Bengaluru."
    },
    {
      "topic": "location",
      "language": "hi",
      "answer": "12 रेजीडेंसी रोड, ब्रिगेड रोड जंक्शन के पास, बेंगलुरु।"
    },
    {
      "topic": "parking",
      "language": "en",
      "answer": "There is complimentary valet parking right at our main entrance from 6 PM onwards, and a multi-level public parking lot 2 minutes away on Museum Road."
    },
    {
      "topic": "parking",
      "language": "hi",
      "answer": "शाम 6 बजे से हमारे मुख्य प्रवेश द्वार पर मानार्थ वैले पार्किंग उपलब्ध है।"
    },
    {
      "topic": "delivery",
      "language": "en",
      "answer": "We deliver across central Bengaluru on Swiggy and Zomato during our regular kitchen hours."
    },
    {
      "topic": "delivery",
      "language": "hi",
      "answer": "हम स्विगी और जोमैटो पर हमारे किचन समय के दौरान डिलीवरी करते हैं।"
    },
    {
      "topic": "specials",
      "language": "en",
      "answer": "Today's chef special is our seasonal Lucknowi Awadhi Thali with smoked Dal Makhani and Dum Biryani."
    },
    {
      "topic": "specials",
      "language": "hi",
      "answer": "आज का स्पेशल शेफ लखनवी अवधी थाली है।"
    },
    {
      "topic": "policies",
      "language": "en",
      "answer": "We hold tables for 15 minutes past the booking time. Parties of more than 8 guests are booked directly with the manager."
    },
    {
      "topic": "policies",
      "language": "hi",
      "answer": "हम बुकिंग समय के 15 मिनट बाद तक टेबल रोकते हैं। 8 से अधिक मेहमानों की बुकिंग मैनेजर द्वारा की जाती है।"
    }
