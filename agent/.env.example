# Copy to agent/.env and fill in. Never commit .env.

# LiveKit (cloud.livekit.io → your project → Settings → API keys). Needed for `dev`, not `console`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech: Deepgram STT (Nova-3) and TTS (Aura-2). console.deepgram.com → API keys
DEEPGRAM_API_KEY=
# Recognition language: en-US (default), en-IN, or multi (also understands Hindi mixed with English,
# but garbles English names). See docs/agent.md for the comparison on Indian-accented calls.
STT_LANGUAGE=en-US
# The agent's voice: any Deepgram Aura-2 English voice, e.g. aura-2-andromeda-en (default)
TTS_VOICE=aura-2-andromeda-en

# LLM: Groq is primary (fastest first token in week-1 tests), Gemini the alternative. Set LLM_PROVIDER to compare.
# aistudio.google.com → API keys. Check its rate-limit page for the Flash model with the best free quota.
GOOGLE_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=groq
GEMINI_MODEL=gemini-3.5-flash-lite
# Lowest thinking level the model accepts: minimal for 3.5 Flash-Lite, low for 3.8 Flash
GEMINI_THINKING_LEVEL=minimal
# Groq models in order; each has its own free per-minute and per-day token budget
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Second language (Sarvam): not used while the agent is English-only
SARVAM_API_KEY=

# Restaurant data. sample (default): a built-in fictional restaurant; bookings are saved in
# agent/.sample_state.json (delete it to reset). api: the web tool API at API_BASE_URL.
DATA_SOURCE=sample
# Restaurant used when the call doesn't say which one (console mode, browser tests)
DEFAULT_RESTAURANT_PHONE=+14155550123

# Call limits that protect the free tiers: longest call, and seconds of silence before
# "Are you still there?" (and again before hanging up)
MAX_CALL_SECONDS=300
SILENCE_CHECK_IN_SECONDS=10

# Text chats (uv run python -m agent.chat telegram): the bot token from @BotFather, and the Telegram
# user IDs allowed to use it, comma-separated (@userinfobot shows yours). Anyone else is turned away.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# The restaurant the bot answers for, by its number in the API. Empty: DEFAULT_RESTAURANT_PHONE
TELEGRAM_RESTAURANT_PHONE=
# Seconds to wait for more messages before replying (a burst gets one reply), and minutes of quiet
# that end a chat (it's then logged; the next message starts a new one)
CHAT_QUIET_SECONDS=1.5
CHAT_IDLE_MINUTES=30

# Telegram calls, for testing (uv run --group telegram-call python -m agent.telegram_call): a Telegram
# *user* account answers calls from TELEGRAM_ALLOWED_USER_IDS with the voice agent. The id and hash
# come from my.telegram.org (API development tools). The login is kept in
# TELEGRAM_CALL_SESSION.session, which is the account's login: never share or commit it.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CALL_SESSION=.telegram_call

# Tool API (web/), used when DATA_SOURCE=api: http://localhost:3000 for the web app run locally
# (cd web && pnpm dev), or http://127.0.0.1:4010 for the Prism mock of contracts/openapi.yaml
API_BASE_URL=http://localhost:3000
# Shared secret sent as the x-agent-key header. Must match AGENT_API_KEY in web/.env.local
AGENT_API_KEY=
