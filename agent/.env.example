# Copy to agent/.env and fill in. Never commit .env.

# Tool API (web/). During development, point this at the Prism mock:
#   npx @stoplight/prism-cli mock contracts/openapi.yaml
API_BASE_URL=http://127.0.0.1:4010
# Shared secret sent as the x-agent-key header. Must match AGENT_API_KEY in web/.env
AGENT_API_KEY=

# LiveKit (cloud.livekit.io → project settings → keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech: Deepgram (STT + Aura TTS), Sarvam (second language)
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# LLM: Gemini (primary, Google AI Studio key), Groq (fallback)
GOOGLE_API_KEY=
GROQ_API_KEY=
